{
  "schemaVersion": 1,
  "id": "vimworldedit",
  "version": "${version}",
  "name": "VimWorldEdit",
  "description": "Vim motions for WorldEdit",
  "authors": ["KKarol01"],
  "contact": {"sources": "https://github.com/ThinCan/Vim-WorldEdit"},
  "license": "CC0-1.0",
  "icon": "assets/vimworldedit/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "org.kkarol01.vimworldedit.client.VimworldeditClient"
    ],
    "main": [
      "org.kkarol01.vimworldedit.Vimworldedit"
    ]
  },
  "mixins": [
    "vimworldedit.mixins.json",
    {
      "config": "vimworldedit.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": ">=${minecraft_version} <=1.21.8",
    "fabric-api": "*",
    "fabric-key-binding-api-v1": "*"
  }
}
